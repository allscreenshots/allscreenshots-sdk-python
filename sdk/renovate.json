{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "schedule": [
    "every monday"
  ],
  "timezone": "UTC",
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "description": "Group minor and patch updates",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "minor-patch-updates",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Separate PRs for major updates",
      "matchUpdateTypes": ["major"],
      "groupName": null,
      "automerge": false
    },
    {
      "description": "Automerge patch updates for dev dependencies",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Pin dependencies for reproducible builds",
      "matchManagers": ["pip_requirements", "pip-compile", "poetry", "pep621"],
      "rangeStrategy": "pin"
    },
    {
      "description": "Group Python GitHub Actions",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    }
  ],
  "pip_requirements": {
    "fileMatch": ["requirements.*\\.txt$"]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "prHourlyLimit": 5,
  "prConcurrentLimit": 10
}
